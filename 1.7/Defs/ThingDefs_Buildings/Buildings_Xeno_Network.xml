			<color>(170,200,190)</color>
			<onlyShowStored>true</onlyShowStored>
		</resource>
		<pipeDefs>
			<li>XMT_SteamPipe</li>
		</pipeDefs>
		<designator>
			<deconstructIconPath>UI/Designators/Break</deconstructIconPath>
			<designationCategoryDef>XMT_Hive</designationCategoryDef>
		</designator>
		<overlayOptions>
			<overlayColor>(170,200,190)</overlayColor>
		</overlayOptions>
	</PipeSystem.PipeNetDef>

	<ThingDef ParentName="BuildingBase">
		<defName>XMT_SteamPipe</defName>
		<label>steam tube</label>
		<description>A resin tube that carries steam. Cryptimorph construction consumes food.</description>
		<thingClass>PipeSystem.Building_Pipe</thingClass>
		<tickerType>Rare</tickerType>
		<graphicData>
			<texPath>Things/Building/Linked/Hive_VentTube</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<linkType>Basic</linkType>
			<linkFlags>
				<li>Custom6</li>
			</linkFlags>
		</graphicData>
		<uiIconPath>Things/Building/Linked/VentTube_MenuIcon</uiIconPath>
		<uiIconScale>0.7</uiIconScale>
		<drawerType>MapMeshOnly</drawerType>
		<altitudeLayer>Conduits</altitudeLayer>
		<passability>Standable</passability>
		<rotatable>false</rotatable>
		<statBases>
			<MaxHitPoints>80</MaxHitPoints>
			<WorkToBuild>35</WorkToBuild>
			<Flammability>0.7</Flammability>
		</statBases>
		<building>
			<isEdifice>false</isEdifice>
			<isInert>true</isInert>
			<ai_chillDestination>false</ai_chillDestination>
		</building>
		<terrainAffordanceNeeded>Resin</terrainAffordanceNeeded>
		<designationCategory>XMT_Hive</designationCategory>
		<clearBuildingArea>false</clearBuildingArea>
		<costList />
		<placeWorkers>
			<li>PipeSystem.PlaceWorker_Pipe</li>
			<li>Xenomorphtype.PlaceWorker_HiveStructureUnlock</li>
		</placeWorkers>
		<drawStyleCategory>Organic1D</drawStyleCategory>
		<comps>
			<li Class="PipeSystem.CompProperties_Resource">
				<pipeNet>XMT_SteamNet</pipeNet>
			</li>
			<li Class="PipeSystem.CompProperties_SpillWhenDamaged">
				<spillEachTicks>600</spillEachTicks>
				<startAtHitPointsPercent>0.333</startAtHitPointsPercent>
				<amountToDraw>1</amountToDraw>
				<chooseFilthFrom>
					<li>XMT_SteamSpill</li>
				</chooseFilthFrom>
			</li>
		</comps>
	</ThingDef>

	<ThingDef ParentName="BuildingBase">
		<defName>XMT_PlumbedGeyser</defName>
		<label>plumbed geyser</label>
		<description>A hive daughter wrapped around a geothermal vent, capturing steam for distribution through the hive.</description>
		<thingClass>Xenomorphtype.PlumbedGeyser</thingClass>
		<size>(4,4)</size>
		<tickerType>Normal</tickerType>
		<rotatable>false</rotatable>
		<bringAlongOnGravship>false</bringAlongOnGravship>
		<graphicData>
			<texPath>Things/Building/PlumbedGeyser/PlumbedGeyser</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(4.5,4.5)</drawSize>
		</graphicData>
		<drawerType>RealtimeOnly</drawerType>
		<altitudeLayer>Building</altitudeLayer>
		<passability>Impassable</passability>
		<fillPercent>1</fillPercent>
		<statBases>
			<MaxHitPoints>1000</MaxHitPoints>
			<Mass>500</Mass>
			<Flammability>0</Flammability>
			<WorkToBuild>1000</WorkToBuild>
		</statBases>
		<terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
		<building>
			<repairable>false</repairable>
			<expandHomeArea>false</expandHomeArea>
			<ai_chillDestination>false</ai_chillDestination>
		</building>
		<placeWorkers>
			<li>PlaceWorker_OnSteamGeyser</li>
			<li>Xenomorphtype.PlaceWorker_HiveStructureUnlock</li>
		</placeWorkers>
		<comps>
			<li>
				<compClass>Xenomorphtype.CompHiveGeneHolder</compClass>
			</li>
			<li Class="Xenomorphtype.CompProperties_PawnPreservation">
				<recovery>
					<li>
						<pawnKind>XMT_StarbeastKind</pawnKind>
						<buildingDef>XMT_PlumbedGeyser</buildingDef>
					</li>
				</recovery>
			</li>
			<li Class="PipeSystem.CompProperties_ResourceStorage">
				<pipeNet>XMT_SteamNet</pipeNet>
				<storageCapacity>500</storageCapacity>
				<contentRequirePower>false</contentRequirePower>
				<destroyOption>
					<thing>XMT_SteamSpill</thing>
					<ratio>10</ratio>
					<maxRadius>1</maxRadius>
				</destroyOption>
				<drawStorageBar>false</drawStorageBar>
			</li>
			<li Class="Xenomorphtype.CompProperties_Steam">
				<role>Geyser</role>
				<production>20</production>
				<resourceInterval>2500</resourceInterval>
				<pipeNet>XMT_SteamNet</pipeNet>
			</li>
			<li Class="Xenomorphtype.CompProperties_Breathing">
				<amplitude>0.01</amplitude>
				<periodTicks>2500</periodTicks>
			</li>
			<li Class="Xenomorphtype.CompSpreadTerrainProperties">
				<spreadTerrain>HiveFloor</spreadTerrain>
				<upgradeTerrain>HeavyHiveFloor</upgradeTerrain>
				<radius>0.5</radius>
				<useOccupiedRect>true</useOccupiedRect>
			</li>
		</comps>
	</ThingDef>

	<ThingDef ParentName="BuildingBase">
		<defName>XMT_SteamVent</defName>
		<label>steam vent</label>
		<description>A resin outlet that consumes steam to heat its room toward 30°C. Consumption is proportional to the temperature deficit. Cryptimorph construction consumes food.</description>
		<tickerType>Normal</tickerType>
		<rotatable>false</rotatable>
		<graphicData>
			<texPath>Things/Building/SteamTubeOutput</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<altitudeLayer>Building</altitudeLayer>
		<passability>PassThroughOnly</passability>
		<fillPercent>0.2</fillPercent>
		<statBases>
			<MaxHitPoints>120</MaxHitPoints>
			<Mass>5</Mass>
			<WorkToBuild>330</WorkToBuild>
			<Flammability>0.7</Flammability>
		</statBases>
		<terrainAffordanceNeeded>Resin</terrainAffordanceNeeded>
		<designationCategory>XMT_Hive</designationCategory>
		<costList />
		<placeWorkers>
			<li>Xenomorphtype.PlaceWorker_HiveStructureUnlock</li>
		</placeWorkers>
		<comps>
			<li Class="PipeSystem.CompProperties_ResourceStorage">
				<pipeNet>XMT_SteamNet</pipeNet>
				<storageCapacity>5</storageCapacity>
				<contentRequirePower>false</contentRequirePower>
				<destroyOption>
					<thing>XMT_SteamSpill</thing>
					<ratio>1</ratio>
					<maxRadius>1</maxRadius>
				</destroyOption>
				<drawStorageBar>false</drawStorageBar>
			</li>
			<li Class="Xenomorphtype.CompProperties_Steam">
				<role>Vent</role>
				<minimumDemandPerInterval>5</minimumDemandPerInterval>
				<consumptionEffect>XMT_SteamVentPuff</consumptionEffect>
				<heatPerSecond>168</heatPerSecond>
				<heatPerSteam>400</heatPerSteam>
				<targetTemperature>30</targetTemperature>
				<resourceInterval>2500</resourceInterval>
				<pipeNet>XMT_SteamNet</pipeNet>
			</li>
		</comps>
	</ThingDef>

	<ThingDef ParentName="BaseFilth">
		<defName>XMT_SteamSpill</defName>
		<modExtensions>
			<li Class="Xenomorphtype.SteamSpillProperties">
				<spillEffect>XMT_SteamSpillCloud</spillEffect>
				<targetTemperature>100</targetTemperature>
				<heatPerUnit>100</heatPerUnit>
				<damage>3</damage>
				<damageDef>Burn</damageDef>
			</li>
		</modExtensions>
		<label>escaping steam</label>
		<description>A fleeting cloud of scalding steam.</description>
		<thingClass>Xenomorphtype.SteamSpill</thingClass>
		<graphicData>
			<texPath>Things/Filth/PoolSoft</texPath>
			<graphicClass>Graphic_Random</graphicClass>
		</graphicData>
		<statBases>
			<Beauty>0</Beauty>
			<Cleanliness>0</Cleanliness>
		</statBases>
		<filth>
			<cleaningWorkToReduceThickness>0</cleaningWorkToReduceThickness>
		</filth>
	</ThingDef>
</Defs>
