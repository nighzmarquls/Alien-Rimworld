	<ThingDef ParentName="BuildingBase">
		<defName>XMT_AcidPit</defName>
		<label>acid pit</label>
		<description>A sentient pool of corrosive blood, formed from a hive daughter. It converts inorganic material into resin and splashes nearby hostiles. Its jelly-backed acid reserve grows slowly.</description>
		<thingClass>Xenomorphtype.AcidPit</thingClass>
		<size>(1,1)</size>
		<tickerType>Normal</tickerType>
		<graphicData>
			<texPath>Things/Building/AcidPit/AcidPit</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(2.0,2.0)</drawSize>
			<drawRotated>false</drawRotated>
			<allowFlip>false</allowFlip>
		</graphicData>
		<uiIconPath>Things/Building/AcidPit/AcidPit_south</uiIconPath>
		<drawerType>RealtimeOnly</drawerType>
		<altitudeLayer>Building</altitudeLayer>
		<passability>PassThroughOnly</passability>
		<fillPercent>0.1</fillPercent>
		<pathCost>100</pathCost>
		<terrainAffordanceNeeded>HeavyResin</terrainAffordanceNeeded>
		<statBases>
			<MaxHitPoints>400</MaxHitPoints>
			<Mass>150</Mass>
			<Flammability>0</Flammability>
			<WorkToBuild>1000</WorkToBuild>
		</statBases>
		<killedLeavings>
			<Starbeast_Flesh_Meat>120</Starbeast_Flesh_Meat>
			<Starbeast_Chitin>80</Starbeast_Chitin>
		</killedLeavings>
		<building>
			<repairable>false</repairable>
			<expandHomeArea>false</expandHomeArea>
			<ai_chillDestination>false</ai_chillDestination>
		</building>
		<constructEffect>ResinBuild</constructEffect>
		<placeWorkers>
			<li>Xenomorphtype.PlaceWorker_HiveStructureUnlock</li>
		</placeWorkers>
		<comps>
			<li>
				<compClass>Xenomorphtype.CompHiveGeneHolder</compClass>
			</li>
			<li Class="Xenomorphtype.CompProperties_PawnPreservation">
				<recovery>
					<li>
						<pawnKind>XMT_StarbeastKind</pawnKind>
						<buildingDef>XMT_AcidPit</buildingDef>
					</li>
				</recovery>
			</li>
			<li Class="Xenomorphtype.CompProperties_RefuelableWithInspect">
				<showFuelInspect>false</showFuelInspect>
				<fuelCapacity>25</fuelCapacity>
				<fuelConsumptionRate>0</fuelConsumptionRate>
				<initialFuelPercent>0</initialFuelPercent>
				<fuelFilter>
					<thingDefs>
						<li>Starbeast_Jelly</li>
					</thingDefs>
				</fuelFilter>
			</li>
			<li Class="Xenomorphtype.CompProperties_AcidPit">
				<inputs>XMT_InorganicResin</inputs>
				<healingInterval>500</healingInterval>
				<healingAmount>50</healingAmount>
				<jellyPerHitPoint>0.2</jellyPerHitPoint>
				<!-- Ten percent of eligible input mass becomes resin; acid cost still uses the full input mass. -->
				<conversionRate>0.1</conversionRate>
				<harvestProduct>XMT_Acid</harvestProduct>
				<!-- Pawn extraction gives 2 acid per 0.45 blood loss: twice a full reserve rounds to 9. -->
				<harvestYield>9</harvestYield>
				<harvestWork>2000</harvestWork>
				<processingEffect>XMT_AcidPitProcessing</processingEffect>
				<splashEffect>XMT_AcidPitSplash</splashEffect>
				<splashEffectDuration>17</splashEffectDuration>
				<targetPriorityFactor>1</targetPriorityFactor>
				<activationRadius>3</activationRadius>
				<splashRange>5</splashRange>
				<splashAngle>60</splashAngle>
				<splashDamage>20</splashDamage>
				<splashDamageDef>AcidBurn</splashDamageDef>
				<splashArmorPenetration>0</splashArmorPenetration>
				<splashAcidFraction>0.5</splashAcidFraction>
				<splashCooldown>150</splashCooldown>
				<splashFilth>Starbeast_Filth_AcidBlood</splashFilth>
				<splashIconPath>UI/Abilities/Starbeast_AcidSplash</splashIconPath>
				<defaultInputs>
					<categories>
						<li>StoneChunks</li>
						<li>StoneBlocks</li>
					</categories>
					<thingDefs>
						<li>Steel</li>
						<li>ChunkSlagSteel</li>
					</thingDefs>
				</defaultInputs>
			</li>
			<li Class="Xenomorphtype.CompAcidBloodProperties">
				<knowledgeProfile>XMT_Profile_Acid</knowledgeProfile>
				<appliedHediff>AcidCorrosion</appliedHediff>
				<splashRange>1.5</splashRange>
				<cells>5</cells>
				<damage>52</damage>
				<acidFilth>Starbeast_Filth_AcidBlood</acidFilth>
			</li>
		</comps>
