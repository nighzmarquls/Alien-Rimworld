<Defs>
	<ThingDef ParentName="BuildingBase">
		<defName>XMT_MeatballLarder</defName>
		<thingClass>Xenomorphtype.MeatballLarder</thingClass>
		<label>meatball Larder</label>
		<comps>
			<li Class="Xenomorphtype.CompProperties_HivePrunable" />
			<li Class="PipeSystem.CompProperties_ResourceStorage">
				<pipeNet>XMT_SteamNet</pipeNet>
				<storageCapacity>20</storageCapacity>
				<contentRequirePower>false</contentRequirePower>
				<drawStorageBar>false</drawStorageBar>
			</li>
			<li Class="Xenomorphtype.CompProperties_Steam">
				<role>Larder</role>
				<production>2</production>
				<targetTemperature>20</targetTemperature>
				<resourceInterval>2500</resourceInterval>
				<pipeNet>XMT_SteamNet</pipeNet>
			</li>
			<li>
				<compClass>Xenomorphtype.CompHiveGeneHolder</compClass>
			</li>
			<li Class="Xenomorphtype.CompMeatBallProperties">
				<feedingResources>
					<li>
						<resourceDef>XMT_OrganicFeeding</resourceDef>
						<growthPerUnit>0.013333333</growthPerUnit>
					</li>
				</feedingResources>
			</li>
			<li Class="Xenomorphtype.CompProperties_Breathing" />
			<li Class="Xenomorphtype.CompProperties_PawnPreservation">
				<extractImplantsOnDestruction>true</extractImplantsOnDestruction>
				<recovery>
					<li>
						<pawnKind>Colonist</pawnKind>
						<buildingDef>XMT_MeatballLarder</buildingDef>
					</li>
				</recovery>
			</li>
			<li Class="CompProperties_Forbiddable" />
		</comps>
		<description>a strange amorpheous mass of quivering flesh. It sucks at the ground wet and hungrily, it trembles and heaves in a terribly pained manner. Feint whimpers can just barely be heard from beneath it.</description>
		<graphicData>
			<texPath>Things/Building/MeatBall</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>CutoutSkin</shaderType>
			<color>(0.9, 0.8, 0.7, 1.0)</color>
			<shadowData>
				<volume>(0.3, 0.6, 0.3)</volume>
				<offset>(0,0,-0.1)</offset>
			</shadowData>
			<drawSize>1</drawSize>
		</graphicData>
		<filthLeaving>Filth_Blood</filthLeaving>
		<drawerType>RealtimeOnly</drawerType>
		<minifiedDef>MinifiedThing</minifiedDef>
		<altitudeLayer>Building</altitudeLayer>
		<passability>PassThroughOnly</passability>
		<selectable>true</selectable>
		<fillPercent>0.20</fillPercent>
		<uiIconScale>0.6</uiIconScale>
		<uiIconOffset>(0, 0.1)</uiIconOffset>
		<leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
		<rotatable>false</rotatable>
		<tickerType>Normal</tickerType>
		<terrainAffordanceNeeded></terrainAffordanceNeeded>
		<!-- so they can be placed on anything?-->
		<statBases>
			<MaxHitPoints>42</MaxHitPoints>
			<Mass>60</Mass>
			<Flammability>1.0</Flammability>
			<MarketValue>42</MarketValue>
			<WorkToBuild>1000</WorkToBuild>
		</statBases>
		<specialDisplayRadius>3.5</specialDisplayRadius>
		<building>
			<repairable>false</repairable>
			<expandHomeArea>false</expandHomeArea>
			<ai_chillDestination>false</ai_chillDestination>
		</building>
		<!--<designationCategory>Xenomorphtype</designationCategory>-->
		<thingCategories>
			<li>BuildingsSecurity</li>
		</thingCategories>
		<placeWorkers>
			<li>PlaceWorker_NeverAdjacentTrap</li>
		</placeWorkers>
	</ThingDef>

	<ThingDef ParentName="BuildingBase">
