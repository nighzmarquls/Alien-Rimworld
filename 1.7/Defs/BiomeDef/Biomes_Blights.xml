<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <BiomeDef Name="XMT_StrippedBiomeBase" Abstract="True">
    <label>barren dustplain</label>
    <description>An extremely hot, dry area, devoid of almost all life. Searing heat and a near total lack of arable land make it very difficult to survive here.</description>
    <workerClass>Xenomorphtype.BiomeWorker_DessicatedBlight</workerClass>
    <settleWarning>Searing heat and a near total lack of arable land make survival here a challenge.</settleWarning>
    <allowFarmingCamps>false</allowFarmingCamps>
    <animalDensity>0.1</animalDensity>
    <plantDensity>0.01</plantDensity>
    <hasVirtualPlants>false</hasVirtualPlants>
    <settlementSelectionWeight>0</settlementSelectionWeight>
    <campSelectionWeight>0</campSelectionWeight>
    <movementDifficulty>1</movementDifficulty>
    <lakeBeachTerrain>BarrenDust</lakeBeachTerrain>
    <riverbankTerrain>BarrenDust</riverbankTerrain>
    <mudTerrain>BarrenDust</mudTerrain>
    <texture>World/Biomes/DessicatedBlight</texture>
    <forageability>0</forageability>
    <wildPlantsCareAboutLocalFertility>false</wildPlantsCareAboutLocalFertility>
    <wildPlantRegrowDays>100</wildPlantRegrowDays>
    <maxFishPopulation>0</maxFishPopulation>
    <fishTypes MayRequire="Ludeon.RimWorld.Odyssey">
      <freshwater_Common></freshwater_Common>
      <freshwater_Uncommon></freshwater_Uncommon>
      <saltwater_Common />
      <saltwater_Uncommon />
    </fishTypes>
    <diseaseMtbDays>90</diseaseMtbDays>
    <isExtremeBiome>true</isExtremeBiome>
    <diseases>
      <li>
        <diseaseInc>Disease_Flu</diseaseInc>
        <commonality>100</commonality>
      </li>
      <li>
        <diseaseInc>Disease_Plague</diseaseInc>
        <commonality>80</commonality>
      </li>
      <li>
        <diseaseInc>Disease_FibrousMechanites</diseaseInc>
        <commonality>30</commonality>
      </li>
      <li>
        <diseaseInc>Disease_SensoryMechanites</diseaseInc>
        <commonality>30</commonality>
      </li>

      <li>
        <diseaseInc>Disease_AnimalFlu</diseaseInc>
        <commonality>100</commonality>
      </li>
      <li>
        <diseaseInc>Disease_AnimalPlague</diseaseInc>
        <commonality>80</commonality>
      </li>
      <li>
        <diseaseInc>Disease_OrganDecay</diseaseInc>
        <commonality>80</commonality>
      </li>
    </diseases>
    <terrainsByFertility>
      <li>
        <terrain>BarrenDust</terrain>
        <min>-999</min>
        <max>999</max>
      </li>
    </terrainsByFertility>
    <terrainPatchMakers>
      <li>
        <perlinFrequency>0.05</perlinFrequency>
        <minSize>13</minSize>
        <thresholds>
          <li>
            <terrain>SoftSand</terrain>
            <min>0.65</min>
            <max>999</max>
          </li>
        </thresholds>
      </li>
    </terrainPatchMakers>
    <baseWeatherCommonalities>
      <Clear>18</Clear>
      <Rain>1</Rain>
      <DryThunderstorm>1</DryThunderstorm>
      <RainyThunderstorm>1</RainyThunderstorm>
      <SnowGentle>1.5</SnowGentle>
      <SnowHard>1</SnowHard>
      <GrayPall MayRequire="Ludeon.RimWorld.Anomaly">1</GrayPall>
      <Sandstorm MayRequire="Ludeon.RimWorld.Odyssey">2</Sandstorm>
    </baseWeatherCommonalities>
    <wildPlants>
		<Plant_GrayGrass MayRequire="Ludeon.RimWorld.Biotech">5</Plant_GrayGrass>
	</wildPlants>
    <wildAnimals>
      <XMT_FleshTick>0.01</XMT_FleshTick>
      <XMT_Plaguerat>0.002</XMT_Plaguerat>
      <XMT_StrangleMoss>0.2</XMT_StrangleMoss>
      <Vulture MayRequire="Ludeon.RimWorld.Odyssey">1</Vulture>
    </wildAnimals>
    <pollutionWildAnimals MayRequire="Ludeon.RimWorld.Biotech">
      <XMT_FleshTick>1</XMT_FleshTick>
      <XMT_Hammerpede>1</XMT_Hammerpede>
    </pollutionWildAnimals>
    <coastalWildAnimals>
      <XMT_Hammerpede>0.1</XMT_Hammerpede>
    </coastalWildAnimals>
    <allowedPackAnimals>
    </allowedPackAnimals>
  </BiomeDef>

  <BiomeDef ParentName="XMT_StrippedBiomeBase">
    <defName>XMT_DessicatedBlight</defName>
  </BiomeDef>

  <BiomeDef ParentName="XMT_StrippedBiomeBase">
    <defName>XMT_BarrenDustbowl</defName>
    <label>barren dustbowl</label>
    <description>A stripped temperate landscape. Every trace of fertile ground has been consumed, leaving gritty dust around lifeless ponds and streams. Only scattered cryptimorphic scavengers persist.</description>
    <settleWarning>The ground is infertile and the waters support no fish.</settleWarning>
    <terrainPatchMakers Inherit="False">
      <li>
        <perlinFrequency>0.015</perlinFrequency>
        <isPond>true</isPond>
        <thresholds>
          <li><terrain>BarrenDust</terrain><min>0.73</min><max>0.93</max></li>
          <li><terrain>WaterShallow</terrain><min>0.93</min><max>999</max></li>
        </thresholds>
      </li>
    </terrainPatchMakers>
    <baseWeatherCommonalities Inherit="False">
      <Clear>18</Clear><Fog>1</Fog><Rain>2</Rain>
      <DryThunderstorm>1</DryThunderstorm><RainyThunderstorm>1</RainyThunderstorm><FoggyRain>1</FoggyRain>
      <SnowGentle>4</SnowGentle><SnowHard>4</SnowHard>
      <GrayPall MayRequire="Ludeon.RimWorld.Anomaly">1</GrayPall>
      <Overcast MayRequire="Ludeon.RimWorld.Odyssey">2</Overcast>
    </baseWeatherCommonalities>
  </BiomeDef>

  <BiomeDef ParentName="XMT_StrippedBiomeBase">
    <defName>XMT_ChilledWaste</defName>
    <label>chilled waste</label>
    <description>A cold, stripped expanse where tundra and boreal soils have been reduced to barren dust. Snow settles over sterile ground, and its frozen or thawed waters support no fish.</description>
    <settleWarning>Harsh winters compound the lack of fertile ground and fish.</settleWarning>
    <terrainPatchMakers Inherit="False">
      <li>
        <perlinFrequency>0.015</perlinFrequency>
        <isPond>true</isPond>
        <thresholds>
          <li><terrain>BarrenDust</terrain><min>0</min><max>0.76</max></li>
          <li><terrain>WaterShallow</terrain><min>0.76</min><max>999</max></li>
        </thresholds>
      </li>
    </terrainPatchMakers>
    <baseWeatherCommonalities Inherit="False">
      <Clear>18</Clear><Fog>2</Fog><Rain>1</Rain>
      <SnowGentle>6</SnowGentle><SnowHard>6</SnowHard>
      <GrayPall MayRequire="Ludeon.RimWorld.Anomaly">1</GrayPall>
      <Overcast MayRequire="Ludeon.RimWorld.Odyssey">2</Overcast>
      <Blizzard MayRequire="Ludeon.RimWorld.Odyssey">1</Blizzard>
    </baseWeatherCommonalities>
  </BiomeDef>

</Defs>
