<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<ThingDef ParentName="HatMakeableBase">
		<defName>XMT_IFFCollar</defName>
		<label>IFF collar</label>
		<description>An identification-friend-or-foe collar adapted to cryptimorphic physiology. Its transponder allows automated turrets belonging to the wearer's faction to recognize the wearer as friendly. It has no effect when worn by humans.</description>
		<techLevel>Industrial</techLevel>
		<graphicData>
			<texPath>Things/Pawn/Humanlike/Apparel/IFFCollar/IFFCollar</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>0.8</drawSize>
		</graphicData>
		<costStuffCount>25</costStuffCount>
		<costList>
			<ComponentSpacer>1</ComponentSpacer>
		</costList>
		<stuffCategories>
			<li>Metallic</li>
			<li>Woody</li>
			<li>Fabric</li>
			<li>Leathery</li>
		</stuffCategories>
		<statBases>
			<MaxHitPoints>80</MaxHitPoints>
			<WorkToMake>1800</WorkToMake>
			<Mass>0.14</Mass>
			<StuffEffectMultiplierArmor>0.0</StuffEffectMultiplierArmor>
			<StuffEffectMultiplierInsulation_Cold>0.00</StuffEffectMultiplierInsulation_Cold>
			<StuffEffectMultiplierInsulation_Heat>0.00</StuffEffectMultiplierInsulation_Heat>
			<EquipDelay>1.5</EquipDelay>
		</statBases>
		<apparel>
			<countsAsClothingForNudity>false</countsAsClothingForNudity>
			<bodyPartGroups>
				<li>Neck</li>
			</bodyPartGroups>
			<wornGraphicPath>Things/Pawn/Humanlike/Apparel/IFFCollar/IFFCollar</wornGraphicPath>
			<layers>
				<li>Overhead</li>
			</layers>
			<renderSkipFlags>
				<li>None</li>
			</renderSkipFlags>
			<canBeDesiredForIdeo>false</canBeDesiredForIdeo>
			<canBeGeneratedToSatisfyWarmth>false</canBeGeneratedToSatisfyWarmth>
			<canBeGeneratedToSatisfyToxicEnvironmentResistance>false</canBeGeneratedToSatisfyToxicEnvironmentResistance>
			<drawData>
				<defaultData>
					<layer>48</layer>
				</defaultData>
				<dataNorth>
					<layer>58</layer>
				</dataNorth>
			</drawData>
		</apparel>
		<colorGenerator Class="ColorGenerator_StandardApparel" />
		<recipeMaker>
			<researchPrerequisites>
				<li>MicroelectronicsBasics</li>
				<li>XMT_Jelly_Extraction</li>
			</researchPrerequisites>
			<displayPriority>175</displayPriority>
		</recipeMaker>
	</ThingDef>

	<ThingDef ParentName="ApparelBase">
		<defName>XMT_PheromoneEmitter</defName>
		<label>pheromone emitter</label>
		<description>A belt-mounted dispenser that applies a selected cryptimorphic pheromone directly over the wearer's body. Its reservoir is refilled with raw pheromone glands.</description>
		<thingClass>Apparel</thingClass>
		<techLevel>Spacer</techLevel>
		<graphicData>
			<texPath>Things/Pawn/Humanlike/Apparel/PheremoneDispenser/PheremoneDispenser</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<statBases>
			<MaxHitPoints>100</MaxHitPoints>
			<WorkToMake>3600</WorkToMake>
			<Mass>2</Mass>
			<Flammability>0.3</Flammability>
			<EquipDelay>2</EquipDelay>
		</statBases>
		<costList>
			<Steel>30</Steel>
			<ComponentIndustrial>1</ComponentIndustrial>
			<XMT_RawPheromone>3</XMT_RawPheromone>
		</costList>
		<comps>
			<li Class="Xenomorphtype.CompProperties_PheromoneEmitter">
				<maxCharges>3</maxCharges>
				<ammoDef>XMT_RawPheromone</ammoDef>
				<ammoCountPerCharge>1</ammoCountPerCharge>
				<baseReloadTicks>60</baseReloadTicks>
				<soundReload>Standard_Reload</soundReload>
				<chargeNoun>pheromone charge</chargeNoun>
				<displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
				<displayGizmoWhileDrafted>true</displayGizmoWhileDrafted>
				<cooldownTicks>1250</cooldownTicks>
				<dose>1</dose>
			</li>
		</comps>
		<recipeMaker>
			<researchPrerequisite>XMT_CryptimorphicPheromones</researchPrerequisite>
			<recipeUsers>
				<li>TableMachining</li>
			</recipeUsers>
			<unfinishedThingDef>UnfinishedPack</unfinishedThingDef>
			<workSpeedStat>GeneralLaborSpeed</workSpeedStat>
			<workSkill>Crafting</workSkill>
			<effectWorking>Smith</effectWorking>
			<soundWorking>Recipe_Smith</soundWorking>
			<skillRequirements>
				<Crafting>5</Crafting>
			</skillRequirements>
			<displayPriority>315</displayPriority>
		</recipeMaker>
		<thingCategories>
			<li>ApparelUtility</li>
		</thingCategories>
		<apparel>
			<wornGraphicPath>Things/Pawn/Humanlike/Apparel/PheremoneDispenser/PheremoneDispenser</wornGraphicPath>
			<countsAsClothingForNudity>false</countsAsClothingForNudity>
			<careIfWornByCorpse>false</careIfWornByCorpse>
			<careIfDamaged>false</careIfDamaged>
			<wearPerDay>0</wearPerDay>
			<bodyPartGroups>
				<li>Waist</li>
			</bodyPartGroups>
			<layers>
				<li>Belt</li>
			</layers>
			<tags>
				<li>BeltDefense</li>
			</tags>
			<developmentalStageFilter>Child, Adult</developmentalStageFilter>
		</apparel>
	</ThingDef>
</Defs>
