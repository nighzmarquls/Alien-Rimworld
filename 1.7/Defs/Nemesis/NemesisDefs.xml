	<!-- Signals explicitly associate evaluator inputs with the observation/evidence contract. -->
	<Xenomorphtype.NemesisSignalDef><defName>XMT_NemesisSignal_ColonyScale</defName><saturation>20</saturation><inputs><li><observation>XMT_NemesisObs_Population</observation><weight>1</weight></li></inputs></Xenomorphtype.NemesisSignalDef>
	<Xenomorphtype.NemesisSignalDef>
		<defName>XMT_NemesisSignal_HiveLossPressure</defName><saturation>8</saturation>
		<inputs><li><evidence>XMT_Nemesis_CryptimorphInjured</evidence><weight>1</weight></li><li><evidence>XMT_Nemesis_CryptimorphKilled</evidence><weight>2</weight></li></inputs>
	</Xenomorphtype.NemesisSignalDef>
