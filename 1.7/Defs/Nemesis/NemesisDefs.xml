	<Xenomorphtype.NemesisSignalDef><defName>XMT_NemesisSignal_IndirectFireThreat</defName><saturation>5</saturation><inputs><li><observation>XMT_NemesisObs_IndirectFirepower</observation><weight>1</weight></li></inputs></Xenomorphtype.NemesisSignalDef>
