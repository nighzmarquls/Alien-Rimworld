<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<Xenomorphtype.NemesisSettingsDef>
		<defName>XMT_NemesisSettings</defName>
		<activationXenoforming>10</activationXenoforming>
		<initialCensusConfidence>0.65</initialCensusConfidence>
		<recentEvidenceCapacity>128</recentEvidenceCapacity>
		<abductedXenotypeProcessingDays>3</abductedXenotypeProcessingDays>
		<stanceCommitmentDays>7</stanceCommitmentDays>
		<challengerMargin>0.15</challengerMargin>
		<maxSpatialContactsPerObservation>256</maxSpatialContactsPerObservation>
		<missionIntervalTicks>60000</missionIntervalTicks>
		<missionOpportunityChance>0</missionOpportunityChance>
		<missionOpportunityChanceAtActivation>0.95</missionOpportunityChanceAtActivation>
		<missionOpportunityChanceExponent>2</missionOpportunityChanceExponent>
		<followUpMinimumXenoforming>20</followUpMinimumXenoforming>
		<followUpChanceByXenoforming>
			<points>
				<li>(20, 0.20)</li>
				<li>(35, 0.40)</li>
				<li>(50, 0.65)</li>
				<li>(75, 0.95)</li>
				<li>(100, 1.00)</li>
			</points>
		</followUpChanceByXenoforming>
		<followUpDelayTicks>600~1800</followUpDelayTicks>
	</Xenomorphtype.NemesisSettingsDef>

	<!-- Evidence taxonomy. Tags are descriptive metadata for future mission and tactic consumers. -->
