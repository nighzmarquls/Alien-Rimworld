	<Xenomorphtype.NemesisSignalDef>
		<defName>XMT_NemesisSignal_Mechanization</defName><saturation>5</saturation>
		<inputs><li><observation>XMT_NemesisObs_Mechanoids</observation><divisorObservation>XMT_NemesisObs_Population</divisorObservation><weight>3</weight></li><li><observation>XMT_NemesisObs_MechanoidBandwidthUsed</observation><weight>1</weight></li><li><observation>XMT_NemesisObs_Inorganic</observation><divisorObservation>XMT_NemesisObs_Population</divisorObservation><weight>2</weight></li><li><observation>XMT_NemesisObs_Vehicles</observation><divisorObservation>XMT_NemesisObs_Population</divisorObservation><weight>3</weight></li><li><observation>XMT_NemesisObs_Turrets</observation><divisorObservation>XMT_NemesisObs_Population</divisorObservation><weight>1</weight></li></inputs>
	</Xenomorphtype.NemesisSignalDef>
	<Xenomorphtype.NemesisSignalDef>
		<defName>XMT_NemesisSignal_TurretDependence</defName><saturation>10</saturation>
		<inputs><li><observation>XMT_NemesisObs_Turrets</observation><divisorObservation>XMT_NemesisObs_Population</divisorObservation><weight>1</weight></li></inputs>
	</Xenomorphtype.NemesisSignalDef>
	<Xenomorphtype.NemesisSignalDef>
		<defName>XMT_NemesisSignal_BiologicalAdaptation</defName><saturation>10</saturation>
		<inputs><li><observation>XMT_NemesisObs_XenotypeDiversity</observation><weight>1</weight></li><li><observation>XMT_NemesisObs_XmtMutatedPawns</observation><weight>1.5</weight></li><li><observation>XMT_NemesisObs_BrainMutatedPawns</observation><weight>1.5</weight></li><li><observation>XMT_NemesisObs_Horrors</observation><weight>1.5</weight></li><li><observation>XMT_NemesisObs_TamedCryptimorphs</observation><weight>1</weight></li></inputs>
	</Xenomorphtype.NemesisSignalDef>
	<Xenomorphtype.NemesisSignalDef><defName>XMT_NemesisSignal_PsychicThreat</defName><saturation>12</saturation><inputs><li><observation>XMT_NemesisObs_PsycasterLevels</observation><weight>1</weight></li><li><observation>XMT_NemesisObs_PsychicPotential</observation><weight>0.75</weight></li><li><evidence>XMT_Nemesis_PsycastCommitted</evidence><weight>1.5</weight></li></inputs></Xenomorphtype.NemesisSignalDef>
	<Xenomorphtype.NemesisSignalDef><defName>XMT_NemesisSignal_Fortification</defName><saturation>8</saturation><inputs><li><observation>XMT_NemesisObs_Walls</observation><divisorObservation>XMT_NemesisObs_Population</divisorObservation><weight>0.12</weight></li><li><observation>XMT_NemesisObs_Turrets</observation><divisorObservation>XMT_NemesisObs_Population</divisorObservation><weight>1</weight></li><li><observation>XMT_NemesisObs_Armor</observation><divisorObservation>XMT_NemesisObs_Population</divisorObservation><weight>0.5</weight></li><li><observation>XMT_NemesisObs_StoredArmor</observation><divisorObservation>XMT_NemesisObs_Population</divisorObservation><weight>0.12</weight></li><li><observation>XMT_NemesisObs_WeaponDamage</observation><divisorObservation>XMT_NemesisObs_Population</divisorObservation><weight>0.05</weight></li><li><observation>XMT_NemesisObs_StoredWeaponDamage</observation><divisorObservation>XMT_NemesisObs_Population</divisorObservation><weight>0.012</weight></li></inputs></Xenomorphtype.NemesisSignalDef>
	<Xenomorphtype.NemesisSignalDef><defName>XMT_NemesisSignal_CryptimorphExploitation</defName><saturation>8</saturation><inputs><li><observation>XMT_NemesisObs_ContainedCryptimorphs</observation><weight>1.5</weight></li><li><evidence>XMT_Nemesis_CryptimorphHarvested</evidence><weight>2</weight></li><li><evidence>XMT_Nemesis_CryptimorphButchered</evidence><weight>2.5</weight></li></inputs></Xenomorphtype.NemesisSignalDef>
	<Xenomorphtype.NemesisSignalDef><defName>XMT_NemesisSignal_AttritionPressure</defName><saturation>8</saturation><inputs><li><observation>XMT_NemesisObs_PawnAreaEffect</observation><weight>1</weight></li><li><observation>XMT_NemesisObs_BuildingAreaEffect</observation><weight>1</weight></li></inputs></Xenomorphtype.NemesisSignalDef>
