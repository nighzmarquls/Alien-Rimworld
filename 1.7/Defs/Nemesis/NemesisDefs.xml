	<!-- Observations are stale snapshots. Traversals are only run when at least one accepted worker requests them. -->
	<Xenomorphtype.NemesisObservationDef Name="XMT_NemesisPawnObservation" Abstract="True">
		<workerClass>Xenomorphtype.NemesisObservationWorker_PawnMetric</workerClass>
		<updateMode>ExplicitCensus</updateMode>
		<traversalCategories><li>SpawnedPawns</li></traversalCategories>
		<baseConfidence>0.75</baseConfidence>
		<staleHalfLifeDays>30</staleHalfLifeDays>
		<minimumConfidence>0.2</minimumConfidence>
	</Xenomorphtype.NemesisObservationDef>
	<Xenomorphtype.NemesisObservationDef Name="XMT_NemesisBuildingObservation" Abstract="True">
		<workerClass>Xenomorphtype.NemesisObservationWorker_BuildingMetric</workerClass>
		<updateMode>ExplicitCensus</updateMode>
		<traversalCategories><li>PlayerBuildings</li></traversalCategories>
		<baseConfidence>0.8</baseConfidence>
		<staleHalfLifeDays>20</staleHalfLifeDays>
		<minimumConfidence>0.2</minimumConfidence>
	</Xenomorphtype.NemesisObservationDef>
	<Xenomorphtype.NemesisObservationDef Name="XMT_NemesisStoredItemObservation" Abstract="True">
		<workerClass>Xenomorphtype.NemesisObservationWorker_StoredItemMetric</workerClass>
		<updateMode>ExplicitCensus</updateMode>
		<traversalCategories><li>StoredItems</li></traversalCategories>
		<baseConfidence>0.75</baseConfidence>
		<staleHalfLifeDays>20</staleHalfLifeDays>
		<minimumConfidence>0.2</minimumConfidence>
	</Xenomorphtype.NemesisObservationDef>

