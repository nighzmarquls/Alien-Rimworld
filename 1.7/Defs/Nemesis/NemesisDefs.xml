		<updateMode>Hybrid</updateMode>
		<baseConfidence>1</baseConfidence>
		<staleHalfLifeDays>0</staleHalfLifeDays>
		<minimumConfidence>1</minimumConfidence>
	</Xenomorphtype.NemesisObservationDef>
