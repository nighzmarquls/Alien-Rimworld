<Defs>
	<HediffDef ParentName="XenomorphtypeBase">
		<defName>XMT_Protofluid</defName>
		<label>discoloration</label>
		<description>A discoloration spreads out from an injection site.</description>
		<everCurableByItem>false</everCurableByItem>
		<makesSickThought>true</makesSickThought>
		<hediffClass>Xenomorphtype.Hediff_Protofluid</hediffClass>
		<makesAlert>true</makesAlert>
		<minSeverity>0</minSeverity>
		<maxSeverity>1</maxSeverity>
		<initialSeverity>1</initialSeverity>
		<stages>
			<li>
				<label>faded</label>
				<becomeVisible>true</becomeVisible>
				<minSeverity>0.4</minSeverity>
				<hungerRateFactorOffset>0.1</hungerRateFactorOffset>
			</li>
			<li>
				<label>dissipating</label>
				<becomeVisible>true</becomeVisible>
				<minSeverity>0.7</minSeverity>
				<hungerRateFactorOffset>0.2</hungerRateFactorOffset>
			</li>
			<li>
				<label>metabolizing</label>
				<becomeVisible>true</becomeVisible>
				<minSeverity>0.8</minSeverity>
				<hungerRateFactorOffset>1</hungerRateFactorOffset>
			</li>
			<li>
				<label>spreading</label>
				<becomeVisible>true</becomeVisible>
				<minSeverity>0.9</minSeverity>
				<hungerRateFactorOffset>0.2</hungerRateFactorOffset>
			</li>
			<li>
				<label>initial</label>
				<becomeVisible>true</becomeVisible>
				<minSeverity>1.0</minSeverity>
				<hungerRateFactorOffset>0.1</hungerRateFactorOffset>
			</li>
		</stages>
		<comps>
		    <li Class="HediffCompProperties_SeverityPerDay">
				<!-- A full exposure metabolizes over three in-game days. -->
                <severityPerDay>-0.33333334</severityPerDay>
			</li>
			<li Class="Xenomorphtype.HediffCompProperties_Mutator">
				<onlyOneMutation>true</onlyOneMutation>
                <completionPreference>0.75</completionPreference>
                <pregnancyProgressPerPulse>0.02</pregnancyProgressPerPulse>
				<probability>0.75</probability>
				<mutateHourInterval>0.08</mutateHourInterval>
				<customMutationSet>XMT_ProtofluidMutationSet</customMutationSet>
                <!-- First-pass exposure shock: normal mutation completion remains preferred. -->
                <toxicShockChance>0.05</toxicShockChance>
                <toxicShockSeverity>0.05</toxicShockSeverity>
			</li>
		</comps>
		<injuryProps>
		  <painPerSeverity>0.1</painPerSeverity>
		  <bleedRate>0.0</bleedRate>
		  <canMerge>true</canMerge>
		  <destroyedLabel>Dissolved</destroyedLabel>
		</injuryProps>
		<modExtensions>
			<li Class="Xenomorphtype.MutationTissueExtension">
				<useDefaultRecognition>true</useDefaultRecognition>
				<summaryLabelKey>XMT_TissueLabel_Exposure</summaryLabelKey>
				<revealedSummaryLabelKey>XMT_TissueLabel_Exposure</revealedSummaryLabelKey>
				<revealedHealthLabelKey>XMT_TissueLabel_Exposure</revealedHealthLabelKey>
				<descriptionKey>XMT_TissueDescription_Exposure</descriptionKey>
				<revealedDescriptionKey>XMT_TissueDescription_Exposure</revealedDescriptionKey>
				<revealedHealthDescriptionKey>XMT_TissueDescription_Exposure</revealedHealthDescriptionKey>
				<diagnoses>
					<li>
						<workerClass>Xenomorphtype.TissueSummary_Mutator</workerClass>
						<labelKey>XMT_AssessmentMutators</labelKey>
						<groupKey>mutagenicActivity</groupKey>
						<priority>0</priority>
						<activeMutator>true</activeMutator>
					</li>
					<li>
						<workerClass>Xenomorphtype.TissueSummary_ToxicStress</workerClass>
						<labelKey>XMT_TissueMutagenicToxicity</labelKey>
						<hazard>true</hazard>
						<groupKey>mutagenicToxicStress</groupKey>
						<priority>50</priority>
					</li>
				</diagnoses>
			</li>
		</modExtensions>

	</HediffDef>

