<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<AbilityDef MayRequire="Ludeon.RimWorld.Biotech" ParentName="AbilityTouchBase">
		<defName>XMT_ReimplantXenogerm</defName>
		<label>implant genes</label>
		<description>Implant this person's xenogenes into a willing subject using a special injector organ. If this person's genes are currently regrowing, they will implant their xenogerm and die in the process.\n\nWhen implanted, a xenogerm will overwrite the target's xenogenes. Germline genes will be unaffected.</description>
		<iconPath>UI/Icons/Genes/Gene_XenogermReimplanter</iconPath>
		<warmupStartSound>ReimplantXenogerm_Cast</warmupStartSound>
		<warmupEffecter>Implant_Xenogerm</warmupEffecter>
		<category>Sanguophage</category>
		<displayOrder>500</displayOrder>
		<hostile>false</hostile>
		<casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
		<verbProperties>
			<verbClass>Verb_CastAbilityTouch</verbClass>
			<drawAimPie>false</drawAimPie>
			<range>-1</range>
			<warmupTime>4</warmupTime>
			<stunTargetOnCastStart>true</stunTargetOnCastStart>
			<targetParams>
				<canTargetAnimals>false</canTargetAnimals>
				<canTargetSelf>false</canTargetSelf>
				<canTargetBuildings>false</canTargetBuildings>
				<canTargetMechs>false</canTargetMechs>
			</targetParams>
		</verbProperties>
		<comps>
			<li Class="Xenomorphtype.CompProperties_AbilityCryptimorphReimplantXenogerm" />
		</comps>
	</AbilityDef>

	<AbilityCategoryDef>
		<defName>Xenomorph</defName>
		<displayOrder>1200</displayOrder>
	</AbilityCategoryDef>

	<Xenomorphtype.PsychicDefenseSettingsDef MayRequire="Ludeon.RimWorld.Royalty">
		<defName>XMT_PsychicDefenseSettings</defName>
		<targetedHeatCost>6</targetedHeatCost>
		<ambientHeatCost>8</ambientHeatCost>
		<ambientIntervalTicks>600</ambientIntervalTicks>
		<minimumContestChance>0.05</minimumContestChance>
		<maximumContestChance>0.95</maximumContestChance>
		<basePsylinkPower>1</basePsylinkPower>
		<alwaysHarmfulVanillaAbilities>
			<li>Neuroquake</li>
		</alwaysHarmfulVanillaAbilities>
		<internallyEnumeratedVanillaAbilities>
			<li>Neuroquake</li>
		</internallyEnumeratedVanillaAbilities>
		<alwaysHarmfulVefAbilities>
			<li>VPE_Neuroquake</li>
		</alwaysHarmfulVefAbilities>
		<ignoredVefAbilities>
			<li>VPE_PsychicDrone</li>
			<li>VPE_Neuroquake</li>
		</ignoredVefAbilities>
	</Xenomorphtype.PsychicDefenseSettingsDef>

	<AbilityDef MayRequire="Ludeon.RimWorld.Royalty">
		<defName>XMT_Ability_PsychicDefense</defName>
		<label>psychic defense</label>
		<description>Maintain a psychic barrier around the queen's aligned cryptimorphs and pawns bearing brain mutations. Hostile psycasts can be opposed at the cost of neural heat.</description>
		<abilityClass>Xenomorphtype.Ability_PsychicDefense</abilityClass>
		<iconPath>UI/Abilities/Painblock</iconPath>
		<displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
		<disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
		<targetRequired>false</targetRequired>
		<aiCanUse>false</aiCanUse>
		<category>Xenomorph</category>
		<uiOrder>7</uiOrder>
		<verbProperties>
			<verbClass>Verb_CastAbility</verbClass>
			<drawAimPie>false</drawAimPie>
			<range>0</range>
			<targetParams>
				<canTargetSelf>true</canTargetSelf>
			</targetParams>
		</verbProperties>
	</AbilityDef>

	<AbilityDef>
		<defName>XMT_Ability_MutagenicMiasma</defName>
		<label>mutagenic miasma</label>
		<description>Releases a cloud of mutagenic spores which infiltrate and subvert exposed tissue.</description>
		<abilityClass>Xenomorphtype.Ability_MutagenicMiasma</abilityClass>
		<iconPath>UI/Abilities/MutagenicMiasma</iconPath>
		<hostile>true</hostile>
		<aiCanUse>true</aiCanUse>
		<displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
		<disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
		<category>Xenomorph</category>
		<cooldownTicksRange>60</cooldownTicksRange>
		<sendMessageOnCooldownComplete>false</sendMessageOnCooldownComplete>
		<casterMustBeCapableOfViolence>true</casterMustBeCapableOfViolence>
		<uiOrder>6</uiOrder>
		<warmupStartSound>FireSpew_Warmup</warmupStartSound>
		<verbProperties>
			<verbClass>Xenomorphtype.Verb_CastMutagenicMiasma</verbClass>
			<label>release miasma</label>
			<warmupTime>1</warmupTime>
			<range>12</range>
			<drawAimPie>false</drawAimPie>
			<requireLineOfSight>true</requireLineOfSight>
			<soundCast>FireSpew_Resolve</soundCast>
			<targetParams>
				<canTargetLocations>true</canTargetLocations>
			</targetParams>
		</verbProperties>
		<comps>
			<li Class="Xenomorphtype.CompProperties_AbilityMutagenicMiasma">
				<filthDef>Starbeast_Filth_Resin</filthDef>
				<fleckDef>XMT_MutagenicMiasmaSmoke</fleckDef>
				<fluHediff>XMT_Flu</fluHediff>
				<minimumFluDurationTicks>120000</minimumFluDurationTicks>
				<canHitFilledCells>true</canHitFilledCells>
			</li>
		</comps>
	</AbilityDef>

	<AbilityDef MayRequire="Ludeon.RimWorld.Biotech">
		<defName>XMT_Ability_NetworkStunPayload</defName>
		<label>network stun payload</label>
		<description>Transmits a stunning cryptomechanical payload into inorganic minds and automated defenses. The signal ignores line of sight, but spares mechanoids controlled by the queen and inorganics carrying an attached subverter.</description>
		<abilityClass>Xenomorphtype.Ability_NetworkStunPayload</abilityClass>
		<iconPath>UI/Abilities/GestateMechanoid</iconPath>
		<hostile>true</hostile>
		<aiCanUse>false</aiCanUse>
		<displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
		<disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
		<category>Xenomorph</category>
		<cooldownTicksRange>60</cooldownTicksRange>
		<sendMessageOnCooldownComplete>false</sendMessageOnCooldownComplete>
		<casterMustBeCapableOfViolence>true</casterMustBeCapableOfViolence>
		<uiOrder>7</uiOrder>
		<verbProperties>
			<verbClass>Xenomorphtype.Verb_CastNetworkStunPayload</verbClass>
			<label>transmit network stun payload</label>
			<warmupTime>1</warmupTime>
			<range>12</range>
			<drawAimPie>false</drawAimPie>
			<requireLineOfSight>false</requireLineOfSight>
			<targetParams>
				<canTargetLocations>true</canTargetLocations>
				<canTargetPawns>true</canTargetPawns>
				<canTargetBuildings>true</canTargetBuildings>
			</targetParams>
		</verbProperties>
