<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<!-- Biological weapons used by humanlike hybrids. -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/HediffDef[defName="XMT_SpikeTongue"]/comps/li[@Class="HediffCompProperties_VerbGiver"]/tools</xpath>
		<value>
			<tools>
				<li Class="CombatExtended.ToolCE">
					<label>tongue</label>
					<capacities><li>Stab</li></capacities>
					<power>10</power>
					<cooldownTime>2</cooldownTime>
					<chanceFactor>0.75</chanceFactor>
					<surpriseAttack>
						<extraMeleeDamages>
							<li><def>Stab</def><amount>10</amount></li>
						</extraMeleeDamages>
					</surpriseAttack>
					<armorPenetrationSharp>15</armorPenetrationSharp>
					<armorPenetrationBlunt>28</armorPenetrationBlunt>
					<soundMeleeHit>Pawn_Melee_BigBash_HitPawn</soundMeleeHit>
					<soundMeleeMiss>Pawn_Melee_BigBash_Miss</soundMeleeMiss>
					<alwaysTreatAsWeapon>true</alwaysTreatAsWeapon>
				</li>
			</tools>
		</value>
	</Operation>

