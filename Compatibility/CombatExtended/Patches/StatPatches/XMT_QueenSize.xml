<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<!-- Size hediffs replace one another, so these offsets are deliberately non-cumulative. -->
	<Operation Class="PatchOperationSequence">
		<operations>
			<li Class="PatchOperationAdd">
				<xpath>Defs/HediffDef[defName="XMT_SizeX1"]/stages/li[1]/statOffsets</xpath>
				<value>
					<CarryWeight>40</CarryWeight>
					<CarryBulk>20</CarryBulk>
				</value>
			</li>
			<li Class="PatchOperationAdd">
				<xpath>Defs/HediffDef[defName="XMT_SizeX2"]/stages/li[1]/statOffsets</xpath>
				<value>
					<CarryWeight>80</CarryWeight>
					<CarryBulk>40</CarryBulk>
				</value>
			</li>
			<li Class="PatchOperationAdd">
				<xpath>Defs/HediffDef[defName="XMT_SizeX3"]/stages/li[1]/statOffsets</xpath>
				<value>
					<CarryWeight>120</CarryWeight>
					<CarryBulk>60</CarryBulk>
				</value>
			</li>
			<li Class="PatchOperationAdd">
				<xpath>Defs/HediffDef[defName="XMT_SizeX4"]/stages/li[1]/statOffsets</xpath>
				<value>
					<CarryWeight>280</CarryWeight>
					<CarryBulk>140</CarryBulk>
				</value>
			</li>
		</operations>
	</Operation>
</Patch>
